  "programs": [
    {
      "name": "an error block grasps at the reading made before the walk",
      "task": "pick, measured",
      "source": [
        "c1 = estimate_pose(object_id=o)",
        "c2 = walk_to(object_id=o)",
        "try:",
        "    c1 = estimate_pose(object_id=o)",
        "except ToolError:",
        "    c3 = grasp(object_id=o, distance_m=c1.distance_m)",
        "    return c3.grasp_id",
        "c4 = grasp(object_id=o, distance_m=c1.distance_m)",
        "return c4.grasp_id"
      ],
      "run": {
        "inputs": {
          "o": "obj_1",
          "p": "obj_2",
          "a": "mug",
          "b": "bottle",
          "d": 0.4
        },
        "answers": {
          "estimate_pose": [
            {
              "distance_m": 0.25
            },
            "lost track"
          ],
          "walk_to": [
            {
              "object_id": "obj_1",
              "arrived": true
            }
          ],
          "grasp": [
            {
              "grasp_id": "g_1"
            }
          ]
        }
      }
    },
